FROM golang:1.26.5-alpine AS builder
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-arm64} go build -o /out/failure-injector ./cmd/failure-injector

FROM alpine:3.20
RUN adduser -D -u 10001 argus
USER argus
WORKDIR /app
COPY --from=builder /out/failure-injector /app/failure-injector
ENTRYPOINT ["/app/failure-injector"]

FROM golang:1.23-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/failure-injector ./cmd/failure-injector

FROM alpine:3.20
RUN adduser -D -u 10001 argus
USER argus
WORKDIR /app
COPY --from=builder /out/failure-injector /app/failure-injector
ENTRYPOINT ["/app/failure-injector"]

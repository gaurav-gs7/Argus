[69,"o","\u001b[2J\u001b[H\u001b[36m========================================================================================================\u001b[0m\r\n\u001b[1mARGUS LIVE DEMO  [07/13]  DETERMINISTIC RCA\u001b[0m\r\n\u001b[2mFixed rules score persisted evidence; identical evidence produces identical output.\u001b[0m\r\n\u001b[36m========================================================================================================\u001b[0m\r\n\r\n"]

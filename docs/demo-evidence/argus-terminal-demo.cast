[69.12,"o","\u001b[32m$ cat rca.json | jq '{deterministic_summary, primary_hypothesis, confidence, contributing_factors}'\u001b[0m\r\n"]
[69.16,"o","{\n  \"deterministic_summary\": \"postgres connection pool saturation; connection acquisition timeout increased likely impacted postgres. Deterministic confidence 0.9500 = clamp(0.35 baseline + 0.7011 evidence score), pointing to PostgreSQL connection pool exhaustion. Topology correlation identified observed root service postgres, grouped 20 alerts across 4 services, and suppressed 18 downstream alerts.\",\n  \"primary_hypothesis\": \"PostgreSQL connection pool exhaustion\",\n  \"confidence\": 0.95,\n  \"contributing_factors\": [\n    \"metric_anomaly from prometheus (confidence 0.91 x weight 0.34 = 0.3094)\",\n    \"log_pattern from loki (confidence 0.87 x weight 0.29 = 0.2523)\",\n    \"service_impact from alertmanager (confidence 0.82 x weight 0.17 = 0.1394)\",\n    \"dependency path: checkout-api -> payments-api -> postgres\",\n    \"dependency path: nginx -> payments-api -> postgres\",\n    \"dependency path: payments-api -> postgres\"\n  ],\n  \"topology\": {\n    \"root_service\": \"postgres\",\n    \"suppressed_alert_count\": 18\n  }\n}\r\n"]
[85,"o","\u001b[2J\u001b[H\u001b[36m========================================================================================================\u001b[0m\r\n\u001b[1mARGUS LIVE DEMO  [08/13]  AI EXPLAINS; IT CANNOT EXECUTE\u001b[0m\r\n\u001b[2mArgus supplies deterministic candidates. Verdikt permits proposal-only output.\u001b[0m\r\n\u001b[36m========================================================================================================\u001b[0m\r\n\r\n"]
[85.04,"o"," deterministic evidence -> bounded candidate list -> LLM ranking -> strict JSON\n                                                     |\n                                                     v\n                                           Verdikt PROPOSE_ONLY\n                                                     |\n                                           executed must be false\r\n"]

ARGUS_ENV=local
ARGUS_HTTP_ADDR=:8080
ARGUS_AI_ADDR=:8090
ARGUS_AI_SERVICE_TOKEN=argus-ai-local
ARGUS_POSTGRES_DSN=postgres://argus:argus@postgres:5432/argus?sslmode=disable
ARGUS_POSTGRES_DSN_LOCAL=postgres://argus:argus@localhost:5432/argus?sslmode=disable
ARGUS_REDIS_ADDR=redis:6379
ARGUS_REDIS_ADDR_LOCAL=localhost:6379
ARGUS_NATS_URL=nats://nats:4222
ARGUS_NATS_URL_LOCAL=nats://localhost:4222
ARGUS_LOG_LEVEL=INFO
ARGUS_INCIDENT_GROUPING_WINDOW=5m
ARGUS_REMEDIATION_EXECUTOR=local
ARGUS_HELIOS_BASE_URL=
ARGUS_HELIOS_ADMIN_TOKEN=
ARGUS_HELIOS_POLL_TIMEOUT=8s
ARGUS_LLM_BACKEND=mock
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:1.5b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite
ARGUS_VERDIKT_URL=http://localhost:8081
ARGUS_VERDIKT_API_TOKEN=argus-verdikt-local
ARGUS_VERDIKT_TIMEOUT_SECONDS=3
VERDIKT_BUILD_CONTEXT=../Verdikt
# Keep these at zero for Ollama, mock, and Gemini free-tier usage.
ARGUS_LLM_INPUT_COST_PER_MILLION_USD=0
ARGUS_LLM_OUTPUT_COST_PER_MILLION_USD=0
# Production: use your IdP's HTTPS issuer and normally leave JWKS URL empty for discovery.
ARGUS_OIDC_ISSUER_URL=http://localhost:8082/realms/argus
ARGUS_OIDC_AUDIENCE=argus-api
ARGUS_OIDC_JWKS_URL=http://keycloak:8080/realms/argus/protocol/openid-connect/certs
ARGUS_OIDC_ROLE_CLAIM=realm_access.roles
ARGUS_OIDC_ROLE_MAPPINGS=argus-admin=admin,argus-operator=operator,argus-viewer=viewer
ARGUS_OIDC_EMAIL_CLAIM=email
ARGUS_OIDC_DISPLAY_NAME_CLAIM=preferred_username
ARGUS_OIDC_SIGNING_ALGS=RS256
ARGUS_OIDC_DISCOVERY_TIMEOUT=5s
ARGUS_OIDC_PROVIDER_TIMEOUT=3s
ARGUS_API_TOKEN=
# Local-only Keycloak bootstrap and demo service-account credentials.
ARGUS_KEYCLOAK_ADMIN_USERNAME=argus-local-admin
ARGUS_KEYCLOAK_ADMIN_PASSWORD=argus-local-admin-password
ARGUS_DEMO_ADMIN_CLIENT_SECRET=argus-local-admin-client-secret
ARGUS_DEMO_OPERATOR_CLIENT_SECRET=argus-local-operator-client-secret
ARGUS_DEMO_VIEWER_CLIENT_SECRET=argus-local-viewer-client-secret
ARGUS_OIDC_TOKEN_URL=http://localhost:8082/realms/argus/protocol/openid-connect/token
# Optional free notification transport. Use mode=slack for a Slack incoming webhook.
ARGUS_APPROVAL_WEBHOOK_URL=
ARGUS_APPROVAL_WEBHOOK_MODE=generic
ARGUS_APPROVAL_WEBHOOK_SECRET=
ARGUS_APPROVAL_CALLBACK_BASE_URL=http://localhost:8080
ARGUS_APPROVAL_TIMEOUT=15m
ARGUS_APPROVAL_ESCALATE_AFTER=5m
ARGUS_APPROVAL_SWEEP_INTERVAL=15s
ARGUS_APPROVAL_NOTIFY_TIMEOUT=3s
ARGUS_APPROVAL_ALLOW_SELF_APPROVAL=false
# Slack interactivity is optional. Map Slack IDs to Argus identities for audit and four-eyes checks.
ARGUS_SLACK_SIGNING_SECRET=
ARGUS_SLACK_BOT_TOKEN=
ARGUS_SLACK_APPROVERS=U01234567=https://identity.example.com/realms/production#oidc-subject
PAYMENTS_API_ADDR=:9001

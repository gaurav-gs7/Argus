FROM golang:1.26.5-alpine AS builder
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-arm64} go build -o /out/argus-api ./cmd/argus-api

FROM alpine:3.20
RUN adduser -D -u 10001 argus
USER argus
WORKDIR /app
COPY --from=builder /out/argus-api /app/argus-api
COPY migrations /app/migrations
EXPOSE 8080
ENTRYPOINT ["/app/argus-api"]

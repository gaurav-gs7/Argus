FROM golang:1.23-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/argus-api ./cmd/argus-api

FROM alpine:3.20
RUN adduser -D -u 10001 argus
USER argus
WORKDIR /app
COPY --from=builder /out/argus-api /app/argus-api
COPY migrations /app/migrations
EXPOSE 8080
ENTRYPOINT ["/app/argus-api"]
